# /etc/x500/x500.conf - local settings for the corrected X500 scripts.
# Installed only by pi/deploy/deploy_x500.sh (explicitly, never by the desktop app).
# Values left empty mean "not configured": the related check reports that, it never passes.
# The deploy script refuses values that still contain NOT_CONFIGURED / PI_USER markers.

# --- network (was hardcoded in x500-net, x500-net-monitor, x500-blackbox, x500-preflight) ---
GROUND_IP=""                 # ground station address, e.g. the laptop's Tailscale IP
ZTE_GATEWAY=""               # ZTE F30 modem gateway address (see: ip route show dev eth1)
WIFI_IF="wlan0"
LTE_IF="eth1"
TAILSCALE_IF="tailscale0"
PING_TARGET="1.1.1.1"        # Internet ICMP probe target
LINK_PATH="wifi"             # wifi | tailscale | lte - path the profile expects

# --- Python / MAVLink (x500-preflight, x500-status) ---
X500_VENV_PYTHON=""          # venv interpreter with pymavlink, e.g. /home/<user>/x500-venv/bin/python
MAVLINK_ENDPOINT="tcp:127.0.0.1:5760"   # mavlink-router TCP server
MAVLINK_SYSID=246            # sysid of the Pi tools: must differ from Mission Planner (255) and the app (247)
MAVLINK_COMPID=26
TARGET_SYSID=0               # vehicle sysid; 0 = first autopilot HEARTBEAT seen

# --- flight controller identity ---
FC_BYID_GLOB="usb-Holybro_Pixhawk6C_*-if00"
EXPECTED_FC_BYID=""          # exact /dev/serial/by-id name to verify (optional)
EXPECTED_HOSTNAME="x500pi"

# --- black box ---
BLACKBOX_DIR="/var/log/x500/blackbox"
BLACKBOX_INTERVAL=10         # target period; the logger subtracts probe time from the sleep
BLACKBOX_RETENTION_DAYS=""   # empty = keep every file (no deletion); a number = delete older daily CSVs

# --- watchdog ---
WATCHDOG_EXPECTED="15s"      # RuntimeWatchdogSec configured in /etc/systemd/system.conf.d/60-x500-watchdog.conf
