#!/bin/bash
# x500-status - corrected: Pi status from the shared collector plus a short, read-only,
# vehicle-filtered MAVLink snapshot (runs with the Pi venv Python).
CONF="${X500_CONF:-/etc/x500/x500.conf}"
PY=""
[ -r "$CONF" ] && PY=$(sed -nE 's/^X500_VENV_PYTHON="?([^"#]*)"?.*/\1/p' "$CONF" | tail -1 | tr -d ' ')
case "$PY" in *PI_USER*|*NOT_CONFIGURED*) PY="" ;; esac
EXTRA=()
if [ -z "$PY" ] || [ ! -x "$PY" ]; then
    echo "note: X500_VENV_PYTHON not set in $CONF - showing Pi status without vehicle telemetry" >&2
    PY=python3
    EXTRA=(--no-mavlink)
fi
export PYTHONPATH="${X500FS_LIB:-/opt/x500fs/lib}${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m x500fs.pi_tools.status "${EXTRA[@]}" "$@"
